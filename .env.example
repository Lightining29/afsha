# =================================================================
# Glowora / Afsha Enterprises - Hostinger Deployment Configuration
# =================================================================

# Server Port (Hostinger default or custom)
PORT=5000
NODE_ENV=production

# MongoDB Connection URI (e.g., MongoDB Atlas connection string)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/glowora?retryWrites=true&w=majority

# JWT Authentication Secret (Generate a strong random string)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_32_chars_min

# Frontend & Domain URLs (Used for CORS and Sitemap generation)
FRONTEND_URL=https://www.afshaenterprises.com
CLIENT_URL=https://www.afshaenterprises.com
SITE_URL=https://www.afshaenterprises.com
ALLOWED_ORIGINS=https://www.afshaenterprises.com,https://afshaenterprises.com

# Razorpay Payment Gateway (Live or Test keys)
RAZORPAY_KEY_ID=rzp_test_or_live_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# SMTP Email Configuration (For order confirmation receipts and OTP verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SECURE=false
SMTP_FROM=Afsha Enterprises <your_email@gmail.com>

# AI API Keys (Optional - For Customer Support AI / Gemini / OpenRouter)
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
